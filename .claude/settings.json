{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/ess_guard.py prompt",
            "timeout": 15,
            "statusMessage": "ESS guardrail: checking the prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/ess_guard.py tool",
            "timeout": 15,
            "statusMessage": "ESS guardrail: checking the action"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/ess_autotest.py",
            "timeout": 120,
            "statusMessage": "ESS auto-test: running the tests"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python tools/tracker.py:*)",
      "Bash(python -m unittest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python tools/ess_guard.py check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(python tools/ess_ship.py:*)",
      "Bash(py tools/ess_ship.py:*)",
      "Bash(py -3.12 tools/ess_ship.py:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout main:*)",
      "Bash(git merge:*)"
    ]
  }
}
